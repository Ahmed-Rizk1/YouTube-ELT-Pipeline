# Airflow Process UID (50000 is default for standard Airflow containers)
AIRFLOW_UID=50000

# Docker Image Specification
DOCKERHUB_NAMESPACE=airflow
DOCKERHUB_REPOSITORY=yt-elt

# Airflow Admin Credentials
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=airflow

# Airflow Fernet Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFcmJdA0qZOhPxnHU=

# YouTube API Credentials
API_KEY=YOUR_YOUTUBE_API_KEY
CHANNEL_HANDLE=@YourChannelHandle

# Primary PostgreSQL Server (docker service name)
POSTGRES_CONN_HOST=postgres
POSTGRES_CONN_PORT=5432
POSTGRES_CONN_USERNAME=postgres
POSTGRES_CONN_PASSWORD=postgres

# Airflow Metadata Database
METADATA_DATABASE_NAME=airflow
METADATA_DATABASE_USERNAME=airflow
METADATA_DATABASE_PASSWORD=airflow

# Celery Result Backend Database
CELERY_BACKEND_NAME=celery
CELERY_BACKEND_USERNAME=celery
CELERY_BACKEND_PASSWORD=celery

# ELT Warehouse Database
ELT_DATABASE_NAME=elt_db
ELT_DATABASE_USERNAME=elt_user
ELT_DATABASE_PASSWORD=elt_password

